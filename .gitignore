.DS_Store
.config/tmux/plugins/
.gitconfig
node_modules/

# Local app data / runtime
.config/alma/
.config/raycast-x/
.config/herdr/*.log
.config/herdr/*.sock
.config/herdr/session.json
.config/herdr/release-notes.json
.config/herdr/.plugins.lock
# btop 退出时自动重写，各机器版本不同，属机器本地状态
.config/btop/btop.conf
.config/btop/btop.log

.config/otty/recipes/

# Claude Code — 白名单式：只跟踪配置意图，运行时数据一律忽略
# （devtoy 上 .claude/projects 已达 67M 会话历史，且含凭据）
.claude/*
!.claude/settings.json
!.claude/settings.local.json
!.claude/CLAUDE.md
!.claude/RTK.md
!.claude/keybindings.json
!.claude/statusline-command.sh
!.claude/agents/
!.claude/commands/
!.claude/skills/
!.claude/hooks/

# Cursor — 项目运行时数据（8.6M/1261 文件，路径含内部项目名）
.cursor/projects/
.cursor/skills-cursor/

# Docker — buildx 状态、CLI 插件二进制（73M）、token seed
.docker/

# 各工具的运行时状态（非配置意图）
.config/codex/
.config/ku/state.json
.config/htop/htoprc
# Homebrew 6 tap 信任机制：trust.json 是配置意图（纳入），.lock 是运行时锁
.config/homebrew/*.lock
# 机器特定的部署产物；PATH 里混着 macOS 路径，待清理后再考虑纳入
.config/systemd/

# Credentials — 切勿提交（仓库是公开的）
.config/.cf/
.claude/.credentials.json
